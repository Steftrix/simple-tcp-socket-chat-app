<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="stefan.app.chatapp.controllers.ChatController"
            style="-fx-background-color: white;">

    <!-- Top Bar -->
    <top>
        <VBox style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 16 20;">
                <VBox spacing="2">
                    <Label fx:id="emailLabel"
                           text="user@example.com"
                           style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #1a1a1a;"/>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="●" style="-fx-font-size: 8px; -fx-text-fill: #4caf50;"/>
                        <Label fx:id="statusLabel"
                               text="Connected"
                               style="-fx-font-size: 11px; -fx-text-fill: #666666;"/>
                    </HBox>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Action Buttons -->
                <HBox spacing="8">
                    <Button text="↻"
                            onAction="#handleReconnect"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #666666;
                                   -fx-font-size: 16px;
                                   -fx-padding: 6 10;
                                   -fx-cursor: hand;
                                   -fx-border-color: transparent;
                                   -fx-background-radius: 2;"/>
                    <Button text="⨯"
                            onAction="#handleDisconnect"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #666666;
                                   -fx-font-size: 16px;
                                   -fx-padding: 6 10;
                                   -fx-cursor: hand;
                                   -fx-border-color: transparent;
                                   -fx-background-radius: 2;"/>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <!-- Chat Messages Area -->
    <center>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    style="-fx-background-color: #fafafa; -fx-background: #fafafa; -fx-border-color: transparent;">
            <VBox fx:id="messageContainer"
                  spacing="2"
                  style="-fx-background-color: #fafafa;">
                <padding>
                    <Insets top="16" right="16" bottom="16" left="16"/>
                </padding>
            </VBox>
        </ScrollPane>
    </center>

    <!-- Bottom Input Area -->
    <bottom>
        <VBox style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0; -fx-padding: 16 20;">
            <HBox spacing="10" alignment="CENTER">
                <TextField fx:id="messageField"
                           promptText="Type a message"
                           HBox.hgrow="ALWAYS"
                           style="-fx-font-size: 13px;
                                 -fx-padding: 9 12;
                                 -fx-background-color: white;
                                 -fx-border-color: #d0d0d0;
                                 -fx-border-width: 1;
                                 -fx-background-radius: 2;
                                 -fx-border-radius: 2;"/>

                <Button fx:id="sendButton"
                        text="Send"
                        onAction="#handleSend"
                        style="-fx-background-color: #0078d4;
                               -fx-text-fill: white;
                               -fx-font-size: 13px;
                               -fx-padding: 9 24;
                               -fx-cursor: hand;
                               -fx-background-radius: 2;"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>