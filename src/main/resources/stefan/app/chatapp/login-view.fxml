<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="20" xmlns:fx="http://javafx.com/fxml"
      fx:controller="stefan.app.chatapp.controllers.LoginController"
      style="-fx-background-color: #f5f5f5;">

    <padding>
        <Insets top="50" right="50" bottom="50" left="50"/>
    </padding>

    <!-- Logo/Title Area -->
    <VBox alignment="CENTER" spacing="8">
        <Label text="Chat" style="-fx-font-size: 28px; -fx-font-weight: 300; -fx-text-fill: #1a1a1a;"/>
        <Label text="Sign in to your account"
               style="-fx-font-size: 13px; -fx-text-fill: #666666;"/>
    </VBox>

    <!-- Login Form -->
    <VBox spacing="16" alignment="CENTER" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-padding: 40 30;">
        <VBox.margin>
            <Insets top="20"/>
        </VBox.margin>

        <VBox spacing="6" prefWidth="320">
            <Label text="Email" style="-fx-font-size: 13px; -fx-text-fill: #333333;"/>
            <TextField fx:id="emailField"
                       promptText="name@example.com"
                       style="-fx-font-size: 13px;
                             -fx-padding: 10 12;
                             -fx-background-color: white;
                             -fx-border-color: #d0d0d0;
                             -fx-border-width: 1;
                             -fx-background-insets: 0;
                             -fx-border-insets: 0;"/>
            <Label fx:id="emailErrorLabel"
                   text=""
                   style="-fx-text-fill: #d32f2f; -fx-font-size: 11px;"
                   managed="false"
                   visible="false"/>
        </VBox>

        <Button fx:id="loginButton"
                text="Sign in"
                onAction="#handleLogin"
                prefWidth="320"
                prefHeight="36"
                style="-fx-background-color: #0078d4;
                       -fx-text-fill: white;
                       -fx-font-size: 14px;
                       -fx-cursor: hand;
                       -fx-background-radius: 2;"/>

        <Separator prefWidth="320" style="-fx-padding: 8 0;"/>

        <VBox spacing="8" alignment="CENTER">
            <Label text="Supported email providers:"
                   style="-fx-font-size: 11px; -fx-text-fill: #666666;"/>
            <Label text="Gmail • Outlook • Yahoo • Hotmail • iCloud • ProtonMail • AOL"
                   style="-fx-font-size: 10px; -fx-text-fill: #999999;"
                   wrapText="true"
                   maxWidth="300"
                   alignment="CENTER"/>
        </VBox>
    </VBox>

</VBox>